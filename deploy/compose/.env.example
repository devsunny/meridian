# Local configuration for the reference product.
# Copy to .env before running Compose. Never commit real secrets.

MERIDIAN_ENV=local
MERIDIAN_DATABASE_URL=postgresql+pg8000://meridian:meridian@postgres:5432/meridian
MERIDIAN_JWT_SECRET=replace-with-32-plus-random-bytes
MERIDIAN_DEMO_PASSWORD=Meridian123!

# Local defaults: filesystem lakehouse. Switch to s3 for the objectstore profile.
MERIDIAN_STORAGE_BACKEND=local
MERIDIAN_STORAGE_ROOT=/data/warehouse
MERIDIAN_LOG_DIR=/data/logs
MERIDIAN_FILE_ROOTS=/data

# Browser-visible endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Observability
MERIDIAN_OTEL_ENABLED=false
MERIDIAN_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# GenAI (optional; extractive RAG works without it)
# MERIDIAN_LLM_BASE_URL=https://api.openai.com/v1
# MERIDIAN_LLM_API_KEY=env:OPENAI_API_KEY
# MERIDIAN_LLM_MODEL=gpt-4o-mini
