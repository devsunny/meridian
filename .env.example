# Source-run configuration (not used by Compose, which has its own env block).
# Copy to .env for API / worker / scheduler run from the repository root.

MERIDIAN_ENV=local
MERIDIAN_DATABASE_URL=sqlite:///./.data/meridian.db
MERIDIAN_STORAGE_BACKEND=local
MERIDIAN_STORAGE_ROOT=./.data/warehouse
MERIDIAN_LOG_DIR=./.data/logs
MERIDIAN_FILE_ROOTS=./.data
MERIDIAN_JWT_SECRET=local-only-change-me-in-production-32bytes
MERIDIAN_DEMO_PASSWORD=Meridian123!
MERIDIAN_AUTH_MODE=local
MERIDIAN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MERIDIAN_OTEL_ENABLED=false
MERIDIAN_LOG_LEVEL=INFO

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
